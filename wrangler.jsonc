{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "apex-crypto-ai-council",
 "main": "worker/src/index.ts",
 "compatibility_date": "2026-11-12",
 "assets": {
  "directory": "./web/dist",
  "binding": "ASSETS",
  "not_found_handling": "single-page-application",
  "run_worker_first": ["/api/*"]
 },
 "d1_databases": [
  { "binding": "DB", "database_name": "apex-crypto-council", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "worker/migrations" }
 ]
}