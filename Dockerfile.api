FROM node:20-alpine
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8787
WORKDIR /app
COPY package.json ./
# tsx is currently declared as a development dependency; install it for this TS entrypoint.
RUN npm install --no-audit --no-fund
COPY src ./src
EXPOSE 8787
CMD ["node", "--import", "tsx", "src/http/server.ts"]
