{
  "name": "apex-crypto-ai-council",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Independent APEX Crypto AI Trading Council — paper-first multi-agent Binance Spot/Futures system. Not part of apex-signal-tank.",
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "start": "tsx src/http/server.ts",
    "dev:api": "tsx watch src/http/server.ts",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "scan": "tsx scripts/run-scan.ts",
    "council": "tsx scripts/run-council-tick.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
